ex="1" parent="1"><mxGeometry x="300.0" y="490.0" width="200" height="66" as="geometry" /></mxCell><mxCell id="7_CU-45" value="CU-45&lt;br&gt;&lt;b&gt;Eliminar menú publicado&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HU-10]&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300.0" y="620.0" width="200" height="66" as="geometry" /></mxCell><mxCell id="7_CU-46" value="CU-46&lt;br&gt;&lt;b&gt;Consultar menús publicados&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HU-10]&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300.0" y="740.0" width="200" height="66" as="geometry" /></mxCell><mxCell id="7_CU-40" value="CU-40&lt;br&gt;&lt;b&gt;Validar nombre, tipo y duplicado del plato&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HU-09]&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720.0" y="90.0" width="200" height="66" as="geometry" /></mxCell><mxCell id="7_CU-42" value="CU-42&lt;br&gt;&lt;b&gt;Verificar que el plato no esté en un menú vigente&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HU-09]&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720.0" y="210.0" width="200" height="66" as="geometry" /></mxCell><mxCell id="7_CU-44" value="CU-44&lt;br&gt;&lt;b&gt;Validar platos del menú (tipo, activo, existente)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HU-10]&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720.0" y="490.0" width="200" height="66" as="geometry" /></mxCell><mxCell id="7_ADM" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90.0" y="420.0" width="40" height="70" as="geometry" /></mxCell><mxCell id="7_e0" value="" style="edgeStyle=entityRelationEdgeStyle;elbow=horizontal;endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="7_ADM" target="7_CU-39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e1" value="" style="edgeStyle=entityRelationEdgeStyle;elbow=horizontal;endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="7_ADM" target="7_CU-41"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e2" value="" style="edgeStyle=entityRelationEdgeStyle;elbow=horizontal;endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="7_ADM" target="7_CU-43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e3" value="" style="edgeStyle=entityRelationEdgeStyle;elbow=horizontal;endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="7_ADM" target="7_CU-45"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e4" value="" style="edgeStyle=entityRelationEdgeStyle;elbow=horizontal;endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="7_ADM" target="7_CU-46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e5" value="" style="edgeStyle=entityRelationEdgeStyle;elbow=horizontal;endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="7_ADM" target="7_CU-27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e6" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="7_CU-39" target="7_CU-40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e7" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="7_CU-41" target="7_CU-39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e8" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="7_CU-41" target="7_CU-42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e9" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="7_CU-27" target="7_CU-44"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7_e10" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="7_CU-27" target="7_CU-43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7_0" value="&lt;b&gt;Notación&lt;/b&gt;&lt;br&gt;Línea continua: asociación actor–caso de uso.&lt;br&gt;Flecha punteada «include»: del caso base al incluido.&lt;br&gt;Flecha punteada «extend»: de la extensión al caso base.&lt;br&gt;[HU..]: historia(s) de usuario que originan el caso de uso." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#999999;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="20" width="330" height="110" as="geometry" /></mxCell><mxCell id="n7_1" value="CU-42 se aplica al desactivar un plato (CA-09.8) y también al cambiar su tipo (CA-09.6): un plato incluido en un menú de hoy o de una fecha futura no puede desactivarse ni cambiar de tipo.&lt;br&gt;&lt;br&gt;CU-44 valida que cada plato elegido exista, esté activo y sea del tipo que corresponde (sopa, principal, postre) (CA-10.3, CA-10.4)." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;size=12;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="330" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ptr" name="9. Trazabilidad CU-HU"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="tr1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Matriz A – Caso de uso → historia(s) de usuario&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;4&quot; style=&quot;font-size:11px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;th bgcolor=&quot;#dae8fc&quot;&gt;ID&lt;/th&gt;&lt;th bgcolor=&quot;#dae8fc&quot;&gt;Caso de uso&lt;/th&gt;&lt;th bgcolor=&quot;#dae8fc&quot;&gt;Actor(es)&lt;/th&gt;&lt;th bgcolor=&quot;#dae8fc&quot;&gt;Historia(s) de usuario&lt;/th&gt;&lt;th bgcolor=&quot;#dae8fc&quot;&gt;Módulo(s)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-01&lt;/td&gt;&lt;td&gt;Iniciar sesión&lt;/td&gt;&lt;td&gt;Administrador, Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-01&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-02&lt;/td&gt;&lt;td&gt;Solicitar recuperación de contraseña&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-01&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-03&lt;/td&gt;&lt;td&gt;Verificar empleado registrado y activo&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-01&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-04&lt;/td&gt;&lt;td&gt;Notificar al administrador&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-01, HU-02&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-05&lt;/td&gt;&lt;td&gt;Consultar notificaciones de recuperación&lt;/td&gt;&lt;td&gt;Administrador&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-02&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-06&lt;/td&gt;&lt;td&gt;Atender solicitud de recuperación&lt;/td&gt;&lt;td&gt;Administrador&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-02&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-07&lt;/td&gt;&lt;td&gt;Restablecer contraseña del empleado&lt;/td&gt;&lt;td&gt;Administrador&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-02, HU-03&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-08&lt;/td&gt;&lt;td&gt;Marcar solicitud como atendida&lt;/td&gt;&lt;td&gt;Administrador&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-02&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-09&lt;/td&gt;&lt;td&gt;Gestionar empleados&lt;/td&gt;&lt;td&gt;Administrador&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-03&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-10&lt;/td&gt;&lt;td&gt;Validar datos obligatorios y unicidad&lt;/td&gt;&lt;td&gt;Administrador&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-03&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-11&lt;/td&gt;&lt;td&gt;Registrar familiar&lt;/td&gt;&lt;td&gt;Administrador, Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-04&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-12&lt;/td&gt;&lt;td&gt;Validar parentesco de primer grado&lt;/td&gt;&lt;td&gt;Administrador, Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-04&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-13&lt;/td&gt;&lt;td&gt;Inscribirse en pensión mensual&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-05&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-14&lt;/td&gt;&lt;td&gt;Validar plazo de inscripción&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-05&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-15&lt;/td&gt;&lt;td&gt;Confirmar almuerzos de lunes a jueves&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-05&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-16&lt;/td&gt;&lt;td&gt;Inscribir a un familiar&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-05&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-17&lt;/td&gt;&lt;td&gt;Reservar almuerzo propio&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-06&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-18&lt;/td&gt;&lt;td&gt;Reservar para familiar registrado&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-06&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-19&lt;/td&gt;&lt;td&gt;Reservar para invitado&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-06&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-20&lt;/td&gt;&lt;td&gt;Validar hora límite y día operativo&lt;/td&gt;&lt;td&gt;Administrador, Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-06, HU-07, HU-08&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M2, M3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-21&lt;/td&gt;&lt;td&gt;Calcular tarifa de la reserva&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-05, HU-06&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-22&lt;/td&gt;&lt;td&gt;Registrar reserva por WhatsApp&lt;/td&gt;&lt;td&gt;Administrador&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-07&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-23&lt;/td&gt;&lt;td&gt;Mostrar resumen y confirmar reserva&lt;/td&gt;&lt;td&gt;Administrador&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-07&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-24&lt;/td&gt;&lt;td&gt;Cancelar reserva&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-08&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-25&lt;/td&gt;&lt;td&gt;Aplicar regla del mínimo de 10 almuerzos&lt;/td&gt;&lt;td&gt;Empleado&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-08&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-26&lt;/td&gt;&lt;td&gt;Registrar inasistencia (corte 09:00)&lt;/td&gt;&lt;td&gt;Administrador&lt;/td&gt;&lt;td&gt;&lt;b&gt;HU-08, HU-12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CU-27&lt;/td&gt;&lt;td&gt;