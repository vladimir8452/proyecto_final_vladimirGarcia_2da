 y="40" width="238" height="98" as="geometry" /></mxCell><mxCell id="1_EmpleadoController" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;controller&amp;raquo;&lt;br&gt;&lt;b&gt;EmpleadoController&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;hr size=&quot;1&quot;&gt;+ registrar(data): array&lt;br&gt;+ actualizar(id, data): array&lt;br&gt;+ cambiarEstado(id, activo): array&lt;br&gt;+ listar(): array&lt;br&gt;+ obtener(id): array" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="275" y="40" width="238" height="143" as="geometry" /></mxCell><mxCell id="1_FamiliarController" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;controller&amp;raquo;&lt;br&gt;&lt;b&gt;FamiliarController&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;hr size=&quot;1&quot;&gt;+ registrar(titularId, nombre,&lt;br&gt;     parentesco, ci): array&lt;br&gt;+ actualizar(...): array&lt;br&gt;+ desactivar(titularId, familiarId)&lt;br&gt;+ listar(titularId): array&lt;br&gt;+ registrarDesdeAdmin(...): array" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="530" y="40" width="238" height="158" as="geometry" /></mxCell><mxCell id="1_ReservaController" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;controller&amp;raquo;&lt;br&gt;&lt;b&gt;ReservaController&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;hr size=&quot;1&quot;&gt;+ reservarTitular(usuarioId, fecha)&lt;br&gt;+ reservarFamiliar(titularId,&lt;br&gt;     familiarId, fecha)&lt;br&gt;+ cancelar(reservaId, titularId)&lt;br&gt;+ registrarEsporadicaAdmin(usuarioId,&lt;br&gt;     familiarId, fecha)&lt;br&gt;+ listarMisReservas(titularId, ...)&lt;br&gt;+ listarPorFecha(fecha)&lt;br&gt;- modalidadDelMes(...): ar