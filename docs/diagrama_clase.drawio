te(anio, mes)&lt;br&gt;- detalleFamiliares(...): array&lt;br&gt;- parametro(clave, defecto)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1550" y="40" width="238" height="128" as="geometry" /></mxCell><mxCell id="1_MUsuario" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;model&amp;raquo;&lt;br&gt;&lt;b&gt;Usuario&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;hr size=&quot;1&quot;&gt;+ findByEmail(correo)&lt;br&gt;+ findById(id)&lt;br&gt;+ listarEmpleados()&lt;br&gt;+ crear(data): int&lt;br&gt;+ actualizar(id, data)&lt;br&gt;+ cambiarEstado(id, activo)&lt;br&gt;+ correoExiste(correo, ...)&lt;br&gt;+ ciExiste(ci, ...)&lt;br&gt;+ codigoExiste(codigo, ...)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="443" width="250" height="203" as="geometry" /></mxCell><mxCell id="1_MFamiliar" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;model&amp;raquo;&lt;br&gt;&lt;b&gt;Familiar&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;hr size=&quot;1&quot;&gt;+ listarPorTitular(titularId)&lt;br&gt;+ contarActivosPorTitular(id)&lt;br&gt;+ findById(id)&lt;br&gt;+ ciExiste(ci, ...)&lt;br&gt;+ crear(titularId, nombre, ...)&lt;br&gt;+ actualizar(id, nombre, ...)&lt;br&gt;+ cambiarEstado(id, estado)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="443" width="250" height="173" as="geometry" /></mxCell><mxCell id="1_MReserva" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;model&amp;raquo;&lt;br&gt;&lt;b&gt;Reserva&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;hr size=&quot;1&quot;&gt;+ crear